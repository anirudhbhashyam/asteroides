#!/usr/bin/env bash

set -e

shopt -s nullglob

RELEASE_NAME=raylib-6.0_macos
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
SRC_DIR=${SCRIPT_DIR}/src
TEST_DIR=${SCRIPT_DIR}/tests
OBJ_DIR=obj
BUILD_TESTS=false
JOBS=1

while [[ $# -gt 0 ]]; do
    case "$1" in
        --tests)
            BUILD_TESTS=true
            shift
            ;;
        --n)
            if [[ -z "${2:-}" || ! "$2" =~ ^[1-9][0-9]*$ ]]; then
                printf 'Error: --n requires a positive integer argument\n' >&2
                exit 1
            fi
            JOBS="$2"
            shift 2
            ;;
        --n=*)
            JOBS="${1#*=}"
            if [[ ! "${JOBS}" =~ ^[1-9][0-9]*$ ]]; then
                printf 'Error: --n requires a positive integer argument\n' >&2
                exit 1
            fi
            shift
            ;;
        *)
            printf 'Error: Unknown option %s\n' "$1" >&2
            exit 1
            ;;
    esac
done

log() {
    printf '  \033[32m>\033[0m %s\n' "$1"
}

if [ ! -d "${RELEASE_NAME}" ]; then
    log "Getting raylib for macos..."
    curl -LO --fail https://github.com/raysan5/raylib/releases/download/6.0/${RELEASE_NAME}.tar.gz
    tar -xf "${RELEASE_NAME}.tar.gz"
    log "Cleanup ${RELEASE_NAME}.tar.gz"
    rm -f "${RELEASE_NAME}.tar.gz"
fi

INCLUDE="-I./${RELEASE_NAME}/include -I./src"
if [[ "${BUILD_TESTS}" == true ]]; then
    INCLUDE="${INCLUDE} -I./tests"
fi
CXXFLAGS="-Wall -Wextra -Werror -Wno-missing-field-initializers -std=c++26 ${INCLUDE}"

FRAMEWORKS="-framework IOKit -framework Cocoa -framework OpenGL"
LIBS="-L./${RELEASE_NAME}/lib -lraylib"
RPATH="-Wl,-rpath,./${RELEASE_NAME}/lib"
LDFLAGS="${FRAMEWORKS} ${LIBS} ${RPATH}"

mkdir -p "${OBJ_DIR}"
OBJECTS=()
PIDS=()

compile() {
    local src="$1"
    local name
    name="$(basename "${src}" .cpp)"
    local obj="${OBJ_DIR}/${name}.o"

    OBJECTS+=("${obj}")
    log "Compiling ${src} -> ${obj}"

    if [[ "${JOBS}" -le 1 ]]; then
        clang++ -c "${src}" -o "${obj}" ${CXXFLAGS}
    else
        while [[ "${#PIDS[@]}" -ge "${JOBS}" ]]; do
            local next_pids=()
            for pid in "${PIDS[@]}"; do
                if kill -0 "${pid}" 2>/dev/null; then
                    next_pids+=("${pid}")
                else
                    wait "${pid}"
                fi
            done
            PIDS=("${next_pids[@]}")
            if [[ "${#PIDS[@]}" -ge "${JOBS}" ]]; then
                sleep 0.02
            fi
        done
        clang++ -c "${src}" -o "${obj}" ${CXXFLAGS} &
        PIDS+=("$!")
    fi
}

for file in ${SRC_DIR}/*.cpp; do
    if [[ ! -f "${file}" ]]; then
        continue
    fi
    if [[ "${BUILD_TESTS}" == true && "$(basename "${file}")" == "main.cpp" ]]; then
        continue
    fi
    compile "${file}"
done

if [[ "${BUILD_TESTS}" == true ]]; then
    for file in ${TEST_DIR}/*.cpp; do
        if [[ ! -f "${file}" ]]; then
            continue
        fi
        compile "${file}"
    done
fi

for pid in "${PIDS[@]}"; do
    wait "${pid}"
done

log "Linking..."
if clang++ "${OBJECTS[@]}" -o a.out ${LDFLAGS}; then
    log "Wrote executable a.out"
else
    log "Error writing executable"
    exit 1
fi
